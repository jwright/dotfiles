#!/usr/bin/env bash
#
# test-bootstrap — run bootstrap.sh against a throwaway $HOME.
#
# Phases 1-3 (command line tools, Homebrew, casks) install system-wide and are
# NOT contained by a $HOME override, so SKIP_SYSTEM declines them by default.
# Phases 4-7 are the ones worth testing, and every one of them is $HOME-relative:
#
#   phase 5  writes ~/.ssh/config and git --global config
#   phase 6  clones into $DOTFILES
#   phase 7  rake link, which rm -rf's whatever sits at each target
#
# Point $HOME at a sandbox and none of that can reach the real machine. What a
# $HOME override does NOT contain is the system-level installs, so those are
# declined too: SKIP_SYSTEM for phases 1-3, SKIP_BUNDLE for brew bundle.
#
# Usage:
#   bin/test-bootstrap             fresh sandbox, full run
#   bin/test-bootstrap --verify    fresh sandbox, assertions only
#   bin/test-bootstrap --keep      reuse the sandbox (proves idempotency)
#   bin/test-bootstrap --bundle    also run brew bundle (touches the real Mac)
#   bin/test-bootstrap --system    allow phases 1-3 to install (touches the real Mac)
#   bin/test-bootstrap --signed-in pass the 1Password gate, so phases 5-7 run
#   bin/test-bootstrap --shell     open a shell inside the sandbox
#   bin/test-bootstrap --reset     delete the sandbox and stop
#
# The sandbox is a plain directory. Resetting is rm -rf; there is no VM state to
# unwind. For a true from-zero test see "Full-fidelity testing" in the README.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SANDBOX="${BOOTSTRAP_SANDBOX:-/tmp/dotfiles-sandbox}"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$1"; }
ok()   { printf '\033[1;32m  ok\033[0m   %s\n' "$1"; }
note() { printf '\033[1;33m  note\033[0m %s\n' "$1"; }

KEEP=false
SHELL_ONLY=false
SKIP_BUNDLE=true
SKIP_SYSTEM=true
ASSUME_SIGNED_IN=false
ARGS=()

for arg in "$@"; do
  case "$arg" in
    --reset)  log "reset"; rm -rf "$SANDBOX"; ok "removed $SANDBOX"; exit 0 ;;
    --keep)   KEEP=true ;;
    --shell)  SHELL_ONLY=true ;;
    --bundle) SKIP_BUNDLE=false ;;
    --system) SKIP_SYSTEM=false ;;
    --signed-in) ASSUME_SIGNED_IN=true ;;
    *)        ARGS+=("$arg") ;;   # passed through to bootstrap.sh, e.g. --verify
  esac
done

# ---------------------------------------------------------------------------
# sandbox
# ---------------------------------------------------------------------------

if $KEEP && [[ -d "$SANDBOX" ]]; then
  log "sandbox"
  ok "reusing $SANDBOX"
else
  log "sandbox"
  rm -rf "$SANDBOX"
  mkdir -p "$SANDBOX/Projects"
  ok "fresh $SANDBOX"

  # Copy the working tree, not a git clone, so uncommitted edits get tested.
  rsync -a --exclude '.git' "$REPO/" "$SANDBOX/Projects/dotfiles/"
  ok "seeded $SANDBOX/Projects/dotfiles from the working tree"
fi

SANDBOX_DOTFILES="$SANDBOX/Projects/dotfiles"

if $SHELL_ONLY; then
  log "shell"
  note "HOME=$SANDBOX — exit to return"
  HOME="$SANDBOX" DOTFILES="$SANDBOX_DOTFILES" exec "${SHELL:-/bin/zsh}"
fi

# ---------------------------------------------------------------------------
# run
# ---------------------------------------------------------------------------

log "bootstrap ${ARGS[*]:-(full run)}"
$SKIP_SYSTEM && note "phases 1-3 will not install; pass --system to allow"
$SKIP_BUNDLE && note "brew bundle skipped; pass --bundle to include it"
echo

set +e
HOME="$SANDBOX" \
DOTFILES="$SANDBOX_DOTFILES" \
SKIP_BUNDLE="$SKIP_BUNDLE" \
SKIP_SYSTEM="$SKIP_SYSTEM" \
ASSUME_SIGNED_IN="$ASSUME_SIGNED_IN" \
  bash "$REPO/bootstrap.sh" "${ARGS[@]}"
status=$?
set -e

# ---------------------------------------------------------------------------
# what actually landed
# ---------------------------------------------------------------------------

echo
log "result (exit $status)"

links=$(find "$SANDBOX" -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')
ok "$links symlinks in the sandbox \$HOME"

if [[ "$links" != "0" ]]; then
  find "$SANDBOX" -maxdepth 1 -type l -exec sh -c \
    'printf "       %s -> %s\n" "$(basename "$1")" "$(readlink "$1")"' _ {} \; | sort | head -25
fi

for f in .ssh/config .gitconfig; do
  [[ -f "$SANDBOX/$f" ]] && ok "wrote $f" || note "no $f"
done

# Nothing here should ever be the real home directory.
[[ "$SANDBOX" == "$HOME" ]] && { echo "REFUSING: sandbox is the real HOME"; exit 1; }

echo
note "inspect: bin/test-bootstrap --shell"
note "reset:   bin/test-bootstrap --reset"
exit $status
